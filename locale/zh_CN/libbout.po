"  -f <选项文件名>\t\t使用 <选项文件名> 中给出的 OPTIONS\n"
"  -o <设置文件名>\t将已使用的 OPTIONS 保存到 <选项文件名>\n"
"  -l, --log <日志文件名>\t将日志输出到 <日志文件名>\n"
"  -v, --verbose\t\t\t提高详细程度\n"
"  -q, --quiet\t\t\t降低详细程度\n"

