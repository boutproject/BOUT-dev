#!/usr/bin/env python3

import boutpp

import numpy as np
import itertools
from sys import exit

errorlist = []
passlist = []
boutpp.init("-d data -q -q -q".split(" "))


def runtests(functions: list[list[str]], derivatives, directions, stag, msg):
    global errorlist
    global passlist

    guards = 2

    for direction in directions:
        direction, fac, diff_func = direction
        locations = ["centre"]
        if stag:
            locations.append(direction.lower() + "low")
        for funcs, derivative, floc, vloc in itertools.product(
            functions, derivatives, locations, locations
        ):
            vfunc, ffunc, outfunc = funcs
            order, diff = derivative

            errors = []
            for nz in nzs:
                boutpp.setOption(
                    f"mesh{direction}:n{direction}",
                    str(nz + (2 * guards if direction == "x" else 0)),
                    force=True,
                )
                boutpp.setOption(
                    f"mesh{direction}:d{direction}",
                    f"2*pi/({nz})",
                    force=True,
                )
                dirnfac = f"{direction}*{fac}"
                mesh = boutpp.Mesh(section="mesh" + direction)
                f = boutpp.create3D(ffunc.format(dirnfac), mesh, outloc=floc)
                v = boutpp.create3D(vfunc.format(dirnfac), mesh, outloc=vloc)
                sim = diff_func(v, f, method=diff, outloc=floc)
                if sim.getLocation() != floc:
                    if floc == "centre" and sim.getLocation() == "centre":
                        pass
                    else:
                        errorlist.append(
                            f"Location does not match - expected {floc} but got {sim.getLocation()}"
                        )
                ana = boutpp.create3D(outfunc.format(dirnfac), mesh, outloc=floc)
                err = sim - ana
                err = err.getAll().flatten()[2:-2]
                err = np.max(np.abs(err))
                errors.append(err)
            errc = np.log(errors[-2] / errors[-1])
            difc = np.log(nzs[-1] / nzs[-2])
            conv = errc / difc

            vfunc = vfunc.format(direction)
            ffunc = ffunc.format(direction)

            if order - 0.1 < conv < order + 0.1:
                info = f"{vfunc} - {ffunc} - {diff} - {direction} - {floc} -> {vloc} "
                passMsg = f"{msg}{direction.upper()}: {info} is working. Expected {order:f} got {conv:f}"
                passlist.append(passMsg)
            else:
                info = f"{vfunc} - {ffunc} - {diff} - {direction} - {floc} -> {vloc} "
                error = f"{msg}{direction.upper()}: {info} is not working. Expected {order:f} got {conv:f}"
                errorlist.append(error)
                if doPlot:
                    from matplotlib import pyplot as plt

                    plt.plot((ana).getAll().flatten())
                    plt.plot((sim).getAll().flatten())
                    plt.show()


mmax = 7
start = 6
doPlot = False
nzs = np.logspace(start, mmax, num=mmax - start + 1, base=2)

functions = [
    ["sin({0})", "sin({0})", "sin({0})*cos({0})"],
    ["sin({0})", "cos({0})", "-sin({0})*sin({0})"],
]

derivatives = [
    [2, "C2"],
    [4, "C4"],
    [1, "U1"],
    [2, "U2"],
    # [3,"W3"] ,
]

directions = [
    ["x", "2*pi", boutpp.VDDX],
    ["y", "1", boutpp.VDDY],
    ["z", "1", boutpp.VDDZ],
]

runtests(functions, derivatives, directions, stag=False, msg="DD")

derivatives = [
    [2, "C2"],
    [4, "C4"],
    [1, "U1"],
    [2, "U2"],
    # [3,"W3"] ,
]

runtests(functions, derivatives, directions, stag=True, msg="DD")

boutpp.finalise()

if errorlist:
    for error in errorlist:
        print(error)
    exit(1)
else:
    print("Pass")
    exit(0)
